          "pick": "Add the batteries found",
          "battery": "Add a battery by its IP address",
          "group": "Create a battery group"
        }
      },
      "pick": {
        "title": "Batteries found",
        "description": "Tick the batteries to add. Each one becomes a device. To make them work together, then create a group (\"Add entry\" → \"Create a battery group\").",
