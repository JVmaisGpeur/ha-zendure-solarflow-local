          "serials": "Batteries"
        }
      },
      "zeroconf_confirm": {
        "title": "Zendure battery found",
        "description": "Add {name} ({host}) to Home Assistant?"
      },
      "battery": {
        "title": "Zendure battery (local)",
        "description": "Battery IP address. The local API must be enabled in the Zendure app (HEMS / local API setting).",
        "data": {
          "host": "IP address"
        }
      },
      "group": {
        "title": "Battery group",
        "description": "A single regulator reads the meter and splits the setpoint between the selected batteries (2 to 4). Each battery keeps its own device and sensors.",
        "data": {
          "name": "Group name",
          "members": "Batteries in the group"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot reach the battery. Check the IP and that the local API is enabled.",
